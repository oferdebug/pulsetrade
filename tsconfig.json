{
"include": [
	"src/**/*.ts",
	"src/**/*.tsx",
	"drizzle.config.ts",
	"vite.config.ts"
],
	"exclude": [
	"node_modules",
	"dist",
	"src/_demo_disabled/**/*",
	"src/components/demo.*",
	"src/hooks/demo.*"
],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		},
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
				"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"src/**/*",
			".vscode/**/*",
			"index.html",
			"vite.config.ts",
			"!src/routeTree.gen.ts",
			"!src/styles.css",
			"!src/routes/demo/**/*",
			"!src/_demo_disabled/**/*",
			"!src/components/demo.*",
			"!src/hooks/demo.*",
			"!src/data/demo-*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "single"
		}
	}
}
